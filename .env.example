# Copie este ficheiro para .env.local e preencha os valores.

# ─── WhatsApp ────────────────────────────────────────────────────────────────
# Número que recebe as encomendas, em formato internacional e só dígitos.
# Ex.: 3519XXXXXXXX (Portugal). Também pode ser definido em src/config/store.ts.
VITE_WHATSAPP_NUMBER=

# ─── Firebase (opcional) ─────────────────────────────────────────────────────
# Consola do Firebase → Definições do projeto → As suas apps → App Web → Configuração.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 'local' (padrão) usa src/data/products.ts; 'firestore' lê as coleções
# "products" e "categories" do Firestore (carregue-as com npm run seed:firestore).
VITE_CATALOG_SOURCE=local

# Com o Firebase configurado, cada pedido é guardado na coleção "orders".
# Defina 'false' para desativar.
VITE_SAVE_ORDERS=true

# Só para desenvolvimento: liga ao emulador local do Firestore
# (firebase emulators:start --only firestore). Deixe vazio em produção.
VITE_FIRESTORE_EMULATOR_HOST=
